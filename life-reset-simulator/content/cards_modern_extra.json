    {"id": "mod_remote_work_dilemma", "title": "居家办公的红利", "description": "公司宣布可以长期居家办公。你发现一天能省下两小时通勤、三十块外卖差价，但镜子里的你已经三天没洗头。", "left_choice": {"text": "彻底居家，谁也不见", "effects": {"WEALTH": 8, "HEALTH": 6, "HAPPINESS": -8, "CHARISMA": -10}, "speech": "省下的钱够买张新床垫。"}, "right_choice": {"text": "每周去公司两天维持人脉", "effects": {"WEALTH": 4, "CHARISMA": 6, "HAPPINESS": 2, "HEALTH": -2}, "speech": "露脸这种事，省不得。"}, "conditions": {"required_traits": [], "min_intelligence": 0}, "weight": 1.0, "era": "modern", "category": "职场生存", "tags": ["workplace", "remote", "wfh"]},
    {"id": "mod_insurance_push", "title": "保险推销的同学", "description": "高中同学突然约你吃饭，席间掏出一份保险方案。他说这不是推销，是关心你。方案的年缴金额正好是你三个月工资。", "left_choice": {"text": "买一份，就当存钱", "effects": {"WEALTH": -10, "HEALTH": 4, "HAPPINESS": -3}, "speech": "万一用上了呢。"}, "right_choice": {"text": "婉拒，说再考虑考虑", "effects": {"CHARISMA": 4, "WEALTH": 2, "HAPPINESS": -1}, "speech": "考虑考虑的意思就是不考虑。"}, "conditions": {"required_traits": [], "min_intelligence": 0}, "weight": 1.0, "era": "modern", "category": "金钱理财", "tags": ["finance", "insurance", "sales"]},
    {"id": "mod_inlaw_chunwan", "title": "除夕去谁家", "description": "结婚第一个除夕，两边父母都等着你们回去。你妈说嫁出去的女儿泼出去的水，她妈说儿子不回来算什么过年。", "left_choice": {"text": "各回各家，各找各妈", "effects": {"HAPPINESS": 6, "CHARISMA": -4, "MORALITY": -2}, "speech": "我们这代人不委屈自己。"}, "right_choice": {"text": "今年你家明年她家", "effects": {"CHARISMA": 6, "HAPPINESS": -2, "STABILITY": 4}, "speech": "轮流制，谁也别亏。"}, "conditions": {"required_traits": [], "min_intelligence": 0}, "weight": 1.0, "era": "modern", "category": "婚恋家庭", "tags": ["family", "inlaw", "newyear"]},
    {"id": "mod_checkup_nodule", "title": "体检报告的结节", "description": "体检报告出来了，甲状腺有个三类结节。医生说观察就行，但你盯着那行字看了二十分钟，上网查了四十篇帖子，越查越慌。", "left_choice": {"text": "立刻挂专家号复查", "effects": {"HEALTH": 6, "WEALTH": -4, "HAPPINESS": -4}, "speech": "查清楚才能睡好觉。"}, "right_choice": {"text": "听医生的，半年后复查", "effects": {"HEALTH": 2, "HAPPINESS": -2, "INTELLIGENCE": 2}, "speech": "焦虑比结节更伤身。"}, "conditions": {"required_traits": [], "min_intelligence": 0}, "weight": 1.0, "era": "modern", "category": "健康身心", "tags": ["health", "checkup", "anxiety"]},
    {"id": "mod_group_redpacket", "title": "同学群的红包接龙", "description": "高中同学群里有人发结婚请柬，紧跟一个红包接龙。你看着200、300、500的数字往上跳，手指悬在屏幕上。", "left_choice": {"text": "随大流包500", "effects": {"WEALTH": -6, "CHARISMA": 6, "HAPPINESS": -2}, "speech": "面子这种税，躲不掉。"}, "right_choice": {"text": "包个吉利数188，潜水", "effects": {"WEALTH": -2, "CHARISMA": -4, "HAPPINESS": 2}, "speech": "毕业后就没说过话，188够了。"}, "conditions": {"required_traits": [], "min_intelligence": 0}, "weight": 1.0, "era": "modern", "category": "社交人情", "tags": ["social", "redpacket", "classmate"]},
    {"id": "mod_neighbor_noise", "title": "楼上的钢琴", "description": "楼上邻居家的孩子每天晚上八点准时练琴，弹得像在拆钢琴。你上门沟通过一次，对方妈妈说孩子要考级，再忍忍。", "left_choice": {"text": "买降噪耳机，忍", "effects": {"WEALTH": -2, "HAPPINESS": -4, "HEALTH": 2}, "speech": "和气生财，和气生财。"}, "right_choice": {"text": "物业投诉加录音取证", "effects": {"CHARISMA": -6, "HAPPINESS": 4, "STABILITY": -3}, "speech": "讲道理没用，那就讲规矩。"}, "conditions": {"required_traits": [], "min_intelligence": 0}, "weight": 1.0, "era": "modern", "category": "社交人情", "tags": ["social", "neighbor", "noise"]},
