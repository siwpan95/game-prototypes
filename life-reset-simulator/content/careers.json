    {"id": "car_gray_loan_shark", "name": "放贷人", "category": "gray", "tier": 3, "description": "你借钱出去，利息按周算。借你钱的人有哭的有跪的有跑路的。你家里供着关公像，香火不断，但你心里清楚——关公要是真显灵，第一个收拾的就是你。", "requires": {"education": "high_school", "charisma": 9, "wealth": 8, "prev_career": "car_gray_broker", "min_age": 28}, "income": 80, "effects_per_year": {"wealth": 15, "charisma": 1, "happiness": -6, "health": -2}, "unlock_events": ["by_career.gray"], "risk": {"caught_prob": 0.40, "consequence": "非法经营罪入狱3-7年", "moral_warning": "高利贷逼死过人，这不是生意是犯罪"}},
    {"id": "car_gray_white_glove", "name": "白手套", "category": "gray", "tier": 4, "description": "你帮“上面的人”打理见不得光的钱。你穿定制西装、出入高档会所，名片上印着“咨询顾问”。但你的手机从不离身，半夜来电话你会惊醒——你知道这是迟早的事。", "requires": {"education": "bachelor", "charisma": 11, "intelligence": 10, "prev_career": "car_gray_loan_shark", "min_age": 35}, "income": 200, "effects_per_year": {"wealth": 30, "charisma": 2, "happiness": -8, "health": -3}, "unlock_events": ["by_career.gray"], "risk": {"caught_prob": 0.55, "consequence": "受贿罪/洗钱罪入狱10年以上", "moral_warning": "替人洗钱，自己也洗不干净"}},
    {"id": "car_gray_inmate", "name": "阶下囚", "category": "gray", "tier": 5, "description": "你进去的那天，新闻里播了三十秒。同监室的人管你叫“老师”，你说别这么叫，我只是个走错路的。出狱时你站在门口看了半天太阳，然后去了趟便利店，买了一包烟——你没抽，只是想确认自己还能买。", "requires": {"prev_career": "car_gray_white_glove", "min_age": 40}, "income": 0, "effects_per_year": {"wealth": -20, "happiness": -10, "health": -5, "charisma": -2}, "unlock_events": ["by_career.gray"], "risk": {"caught_prob": 1.0, "consequence": "已成既定事实", "moral_warning": "走错一步，要用余生来还"}}
