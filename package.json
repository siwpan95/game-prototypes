{
  "name": "text-adventure-host",
  "version": "0.1.0",
  "private": true,
  "description": "Cordis host for the text-adventure puzzle service (Python puzzles over a JSON-RPC stdio bridge)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node src/boot.mjs",
    "dev": "node --watch src/boot.mjs",
    "smoke": "node src/smoke.mjs",
    "check:client": "node src/check_client.mjs",
    "e2e:browser": "node src/browser_e2e.mjs",
    "test": "node src/check_client.mjs && node src/smoke.mjs && node src/browser_e2e.mjs"
  },
  "dependencies": {
    "@cordisjs/plugin-loader": "^1.0.0-rc.8",
    "@cordisjs/plugin-logger-console": "^1.0.0",
    "cordis": "^4.0.0-rc.10"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "1.64.1"
  }
}
